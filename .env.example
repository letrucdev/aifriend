# Lấy API key tại: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Tên model Gemini sẽ dùng. Mặc định gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# (Tuỳ chọn) Fallback sang OpenAI khi Gemini bị 429 (hết quota) hoặc 5xx.
# Lấy key tại: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Mặc định gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini

# Rate limit theo IP (in-memory) — tăng nếu cần.
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_DAY=100
NEXT_PUBLIC_SITE_URL=

# (Tuỳ chọn) Webhook Google Apps Script để lưu đánh giá Mây vào Trang tính.
# Hướng dẫn setup nhanh: docs/feedback-google-sheet.md
GOOGLE_SHEETS_WEBHOOK_URL=